{
  "branchPrefix": "renovate/",
  "baseBranchPatterns": ["main"],
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if isPatch}}-{{{newMinor}}}{{/if}}-x{{#if isLockfileUpdate}}-lockfile{{/if}}",
  // Every update automerges once branch protection's "all tests pass" check is
  // green (GitHub native auto-merge, squash). The full Test and Publish matrix
  // is the gate; nothing merges red. PRs are opened immediately (Renovate's
  // default) - our matrix only runs on `pull_request`, so waiting on branch
  // status would deadlock.
  "automerge": true,
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  // Treat the package's own top-level "version" field as if it were a
  // dependency on google-protobuf. When google-protobuf publishes a new
  // version Renovate rewrites this line in the same PR as the devDependency
  // bump - no post-upgrade shell command needed - and the publish workflow's
  // "gate" job then cuts a release because the new version is not yet on npm.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": [
        "\"name\": \"protoc-gen-js\",\\s*\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "google-protobuf",
      "datasourceTemplate": "npm"
    },
    {
      // Bump *plain* GitHub-hosted runner labels in the workflow matrices, e.g.
      // "macos-16" or "ubuntu-26.04" once GitHub GAs a newer image. The built-in
      // github-runners manager only scans `runs-on:` values, not matrix `os:`
      // arrays, hence this regex. Suffixed labels (-intel, -arm) and the
      // self-updating *-latest aliases are intentionally NOT matched - see
      // .github/ci-runner-maintenance.md for how those are handled.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "\"(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9][0-9.]+)\""
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      // Keep the package version and the google-protobuf devDependency in
      // lockstep in one PR. Auto-merge is HELD for now: protobuf-javascript
      // v4.0.1 shipped without its win64 archive, so protoc-gen-js cannot
      // release 4.0.1, and we do not want npm to jump 4.0.0 -> 4.0.2 out of
      // order. Merge the google-protobuf PR by hand once the ordering is
      // resolved, or set "automerge" back to true to resume auto-releases.
      "groupName": "google-protobuf",
      "matchPackageNames": ["google-protobuf"],
      "automerge": false
    },
    {
      // Never even open a major-bump PR for undici or fflate while the engine
      // floor is Node 18 (see package.json "engines"). undici >= 7 requires
      // Node >= 20.18 and, with engineStrict, breaks `npm ci` on the Node 18 CI
      // legs; a fflate major could break zip extraction. Minor / patch updates
      // (including security fixes) still flow and automerge. Re-enable only when
      // the Node floor moves to 20+.
      "matchPackageNames": ["undici", "fflate"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // Never touch @types/node at all. It is dev-only editor sugar and any
      // update only ever moves it ahead of the oldest supported runtime; there
      // is no version of it we want Renovate to propose.
      "matchPackageNames": ["@types/node"],
      "enabled": false
    },
    {
      // Never touch the "engines" constraint. The Node floor is a deliberate
      // policy decision (it gates the whole fetch / proxy design), not a
      // dependency to bump.
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
