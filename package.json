{
  "name": "protoc-gen-js",
  "version": "4.0.1",
  "description": "A protoc-gen-js binary for npm.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "post-install.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "protoc-gen-js": "cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yinzara/protoc-gen-js"
  },
  "author": "Matt Vance <yinzara@gmail.com>",
